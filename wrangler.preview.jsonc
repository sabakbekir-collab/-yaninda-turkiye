{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaninda-turkiye-pr31-preview",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yaninda-turkiye-preview-db",
      "database_id": "a974803a-d0da-4baf-acef-f46cf3588623",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
