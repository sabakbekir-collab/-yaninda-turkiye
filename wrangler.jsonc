{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaninda-turkiye",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yaninda-turkiye-db",
      "database_id": "3edba257-0694-4b38-adb4-865e4aa9dac4"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
