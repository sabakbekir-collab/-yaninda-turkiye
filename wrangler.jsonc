{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yaninda-turkiye",
  "main": "./worker/index.ts",
  "workers_dev": true,
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
