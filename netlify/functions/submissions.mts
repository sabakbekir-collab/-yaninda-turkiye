import type{Config}from'@netlify/functions';import{db}from'../../db/index.js';import{submissions}from'../../db/schema.js';
const text=(v:unknown,n=300)=>typeof v==='string'?v.trim().replace(/[<>]/g,'').slice(0,n):'';
export default async(req:Request)=>{if(req.method!=='POST')return new Response(null,{status:405});try{const b=await req.json(),name=text(b.name,120),category=text(b.category,50),phone=text(b.phone,25),address=text(b.address,300),province=text(b.province,50),district=text(b.district,80);if(name.length<2||address.length<10||!province||!district||!/^[-+() 0-9]{10,20}$/.test(phone))return Response.json({error:'invalid_input'},{status:400});await db.insert(submissions).values({name,category,phone,whatsapp:text(b.whatsapp,25)||null,address,province,district,description:text(b.description,800)||null,hours:text(b.hours,150)||null});return Response.json({ok:true},{status:201})}catch{return Response.json({error:'service_unavailable'},{status:503})}};
export const config:Config={path:'/api/submissions'};
