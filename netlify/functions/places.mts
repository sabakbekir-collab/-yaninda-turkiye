import type{Config}from'@netlify/functions';import{and,eq,gt}from'drizzle-orm';import{db}from'../../db/index.js';import{apiCache,submissions}from'../../db/schema.js';
type OsmEl={type:string;id:number;lat?:number;lon?:number;center?:{lat:number;lon:number};tags?:Record<string,string>};
const filters:Record<string,string>= {pharmacy:'["amenity"="pharmacy"]',hospital:'["amenity"~"hospital|clinic"]',atm:'["amenity"="atm"]',police:'["amenity"="police"]',fire_station:'["amenity"="fire_station"]',fuel:'["amenity"="fuel"]',taxi:'["amenity"="taxi"]',market:'["shop"~"supermarket|convenience"]',restaurant:'["amenity"~"restaurant|fast_food"]',hotel:'["tourism"~"hotel|hostel|guest_house"]',cargo:'["amenity"="post_office"]',towing:'["service:vehicle:recovery"="yes"]',government:'["office"="government"]',electrician:'["craft"="electrician"]',plumber:'["craft"="plumber"]',locksmith:'["craft"="locksmith"]',cleaning:'["craft"="cleaning"]',moving:'["craft"="moving_company"]',hvac:'["craft"~"hvac|heating_engineer"]',painter:'["craft"="painter"]',car_repair:'["shop"="car_repair"]',tyres:'["shop"="tyres"]',phone_repair:'["shop"="mobile_phone"]',computer_repair:'["shop"="computer"]',furniture:'["craft"="carpenter"]',gardener:'["craft"="gardener"]',other:'["craft"]',service:'["craft"]'};
const distance=(a:number,b:number,c:number,d:number)=>{const r=6371,to=(x:number)=>x*Math.PI/180,dy=to(c-a),dx=to(d-b),v=Math.sin(dy/2)**2+Math.cos(to(a))*Math.cos(to(c))*Math.sin(dx/2)**2;return 2*r*Math.asin(Math.sqrt(v))};
const clean=(s?:string)=>s?.replace(/[<>]/g,'').slice(0,300);
export default async(req:Request)=>{if(req.method!=='GET')return new Response('Method not allowed',{status:405});const u=new URL(req.url),category=u.searchParams.get('category')||'pharmacy',province=clean(u.searchParams.get('province')||''),district=clean(u.searchParams.get('district')||'');if(!filters[category])return Response.json([]);let lat=Number(u.searchParams.get('lat')),lon=Number(u.searchParams.get('lon'));if(!Number.isFinite(lat)||!Number.isFinite(lon)){if(!province)return Response.json([]);try{const query=encodeURIComponent(`${district?district+', ':''}${province}, Türkiye`);const g=await fetch(`https://nominatim.openstreetmap.org/search?format=json&limit=1&countrycodes=tr&q=${query}`,{headers:{'User-Agent':`YanimdaTurkiye/1.0 (${process.env.OSM_CONTACT_EMAIL||'public-web-app'})`},signal:AbortSignal.timeout(7000)});const found=(await g.json())[0];if(!found)return Response.json([]);lat=Number(found.lat);lon=Number(found.lon)}catch{return Response.json([])}}if(lat<35||lat>43||lon<25||lon>46)return Response.json([]);const key=`places:v4:${category}:${lat.toFixed(3)}:${lon.toFixed(3)}:${province}:${district}`;try{const cached=await db.select().from(apiCache).where(and(eq(apiCache.cacheKey,key),gt(apiCache.expiresAt,new Date()))).limit(1);if(cached[0]&&Array.isArray(cached[0].payload)&&cached[0].payload.length>0)return Response.json(cached[0].payload,{headers:{'Cache-Control':'no-store, max-age=0','X-Data-Source':'cache','X-Places-Version':'v5'}})}catch{/* Database cache is optional; continue with source. */}const f=filters[category];
const query=category==='government'
  ? `[out:json][timeout:20];(node["office"="government"](around:12000,${lat},${lon});way["office"="government"](around:12000,${lat},${lon});relation["office"="government"](around:12000,${lat},${lon});node["amenity"~"townhall|courthouse|public_building"](around:12000,${lat},${lon});way["amenity"~"townhall|courthouse|public_building"](around:12000,${lat},${lon});relation["amenity"~"townhall|courthouse|public_building"](around:12000,${lat},${lon});node["government"](around:12000,${lat},${lon});way["government"](around:12000,${lat},${lon});relation["government"](around:12000,${lat},${lon});node["public_service"](around:12000,${lat},${lon});way["public_service"](around:12000,${lat},${lon});relation["public_service"](around:12000,${lat},${lon}););out center tags 60;`
  : `[out:json][timeout:18];(node${f}(around:12000,${lat},${lon});way${f}(around:12000,${lat},${lon});relation${f}(around:12000,${lat},${lon}););out center tags 40;`;let body:{elements:OsmEl[]}|null=null;const endpoints=['https://overpass-api.de/api/interpreter','https://overpass.kumi.systems/api/interpreter','https://overpass.private.coffee/api/interpreter'];for(const endpoint of endpoints){try{const response=await fetch(endpoint,{method:'POST',headers:{'content-type':'application/x-www-form-urlencoded','User-Agent':'YanimdaTurkiye/1.0'},body:`data=${encodeURIComponent(query)}`,signal:AbortSignal.timeout(12000)});if(!response.ok)continue;const candidate=await response.json() as{elements?:OsmEl[]};if(Array.isArray(candidate.elements)){body={elements:candidate.elements};break}}catch{/* try the next public Overpass endpoint */}}if(!body)throw new Error('all sources unavailable');const places=body.elements.filter(x=>{const tags=x.tags||{};const required=filters[category];if(category==='pharmacy')return tags.amenity==='pharmacy';if(category==='hospital')return tags.amenity==='hospital'||tags.amenity==='clinic';if(category==='market')return tags.shop==='supermarket'||tags.shop==='convenience';if(category==='restaurant')return tags.amenity==='restaurant'||tags.amenity==='fast_food';if(category==='hotel')return tags.tourism==='hotel'||tags.tourism==='hostel'||tags.tourism==='guest_house';if(category==='fuel')return tags.amenity==='fuel';if(category==='atm')return tags.amenity==='atm';if(category==='police')return tags.amenity==='police';if(category==='fire_station')return tags.amenity==='fire_station';if(category==='taxi')return tags.amenity==='taxi';if(category==='cargo')return tags.amenity==='post_office';if(category==='government')return tags.office==='government'||['townhall','courthouse','public_building'].includes(tags.amenity||'')||Boolean(tags.government)||Boolean(tags.public_service);return Boolean(required)}).map(x=>{const p=x.center||{lat:x.lat!,lon:x.lon!},tags=x.tags||{},address=[tags['addr:street'],tags['addr:housenumber'],tags['addr:district'],tags['addr:city']].filter(Boolean).join(' ');return{id:`osm-${x.type}-${x.id}`,name:clean(tags.name||tags.operator||tags.brand)||'İsimsiz açık veri kaydı',category,lat:p.lat,lon:p.lon,address:clean(address),phone:clean(tags.phone||tags['contact:phone']),openingHours:clean(tags.opening_hours),website:clean(tags.website),operator:clean(tags.operator||tags.brand),source:'OpenStreetMap',distance:distance(lat,lon,p.lat,p.lon)}}).filter(p=>Number.isFinite(p.lat)&&Number.isFinite(p.lon)).sort((a,b)=>a.distance-b.distance);let approved:typeof submissions.$inferSelect[]=[];try{const approvedFilter=province&&district?and(eq(submissions.status,'approved'),eq(submissions.category,category),eq(submissions.province,province),eq(submissions.district,district)):and(eq(submissions.status,'approved'),eq(submissions.category,category));approved=await db.select().from(submissions).where(approvedFilter);}catch{/* OSM results remain available. */}const result=[...approved.filter(x=>x.latitude&&x.longitude).map(x=>({id:`approved-${x.id}`,name:x.name,category:x.category,lat:x.latitude,lon:x.longitude,address:x.address,phone:x.phone,openingHours:x.hours,source:'Yanımda Türkiye — onaylı kayıt',distance:distance(lat,lon,x.latitude!,x.longitude!)})),...places].slice(0,40);if(result.length>0){try{await db.insert(apiCache).values({cacheKey:key,payload:result,expiresAt:new Date(Date.now()+30*60*1000)}).onConflictDoUpdate({target:apiCache.cacheKey,set:{payload:result,expiresAt:new Date(Date.now()+30*60*1000)}})}catch{/* cache is optional */}}return Response.json(result,{headers:{'Cache-Control':'no-store, max-age=0','X-Data-Source':'OpenStreetMap','X-Places-Version':'v5'}})}catch{return Response.json([],{headers:{'Cache-Control':'no-store, max-age=0','X-Places-Version':'v5'}})}};
export const config:Config={path:'/api/places'};
